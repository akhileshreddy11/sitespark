# Safe local default: no external requests, messages, payments, or deployment.
DRY_RUN=true
DATABASE_URL=sqlite:///./sitespark.db
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com/v1
GOOGLE_MAPS_EMBED_API_KEY=
GOOGLE_PLACES_CACHE_TTL_DAYS=30
MIN_LEAD_SCORE=60
MAX_PLACE_DETAILS_PER_RUN=50
MAX_ESTIMATED_COST_USD_MICROS_PER_RUN=5000000
QUEUE_MODE=local
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO
DEMO_PREVIEW_BASE_URL=http://127.0.0.1:8000
DEMO_EXPIRY_DAYS=14
DEMO_MAX_RETRIES=3
DEMO_DEPLOY_ENABLED=false
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=https://api.openai.com/v1
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=
CLOUDFLARE_PREVIEW_DOMAIN=
SCREENSHOT_UPLOAD_URL=
SCREENSHOT_UPLOAD_TOKEN=
